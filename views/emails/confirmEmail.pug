extends baseEmail

block content
  p Hi #{firstName},
  p Welcome to Natours! 🎉
  p Thanks for creating your account. Please verify your email address to activate your account and start exploring our tours.
  p Click the button below to verify your email:
  table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
    tbody
      tr
        td(align='left')
          table(role='presentation', border='0', cellspacing='0', cellpadding='0')
            tbody
              tr
                td
                  a(href=`${url}`, target='_blank') Verify Email
  p This verification link will expire in 10 minutes.
  p If you didn't create a Natours account, you can safely ignore this email.
  p
    | Best regards,
    br
    | The Natours Team